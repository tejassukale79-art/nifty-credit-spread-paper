[Unit]
Description=Tick-live P&L server (streams LTP, writes results/live_ticks.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/paper/src
ExecStart=/home/ubuntu/tickenv/bin/python /home/ubuntu/paper/src/tick_server.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
# tick_server.py's log() already writes results/tick_server.log itself; sending
# stdout there too duplicated every line. Route it to the journal instead
# (journalctl -u tick-server) so tracebacks are still captured, once.
StandardOutput=journal
StandardError=journal
