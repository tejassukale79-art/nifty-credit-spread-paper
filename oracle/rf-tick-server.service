[Unit]
Description=Ratio-Fluxer tick-live P&L server (streams LTP, writes results/rf_live_ticks.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/paper/src
ExecStart=/home/ubuntu/tickenv/bin/python /home/ubuntu/paper/src/rf_tick_server.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
